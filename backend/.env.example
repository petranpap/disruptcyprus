APP_NAME="Disrupt Cyprus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Main host: landing, share pages, admin
APP_URL=http://localhost:8080
# PWA origin (also serves /api and /sanctum in production)
FRONTEND_URL=http://localhost:5173
# Media URLs are root-relative (/storage) so both hosts serve them same-origin. Override only for a CDN.
# MEDIA_URL=/storage
# Business timezone for digests, "this week", scheduler
APP_BUSINESS_TIMEZONE=Asia/Nicosia

APP_LOCALE=el
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=el_GR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=disrupt
DB_USERNAME=disrupt
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Comma-separated hosts allowed to use cookie (SPA) auth
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8080,127.0.0.1:5173,127.0.0.1:4173,localhost:4173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=disrupt

# Redis is not used (not installed on the production server).

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@disruptcyprus.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${FRONTEND_URL}/api/v1/auth/social/google/callback"

# Web Push (Phase 6): php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:hello@disruptcyprus.com"

# Seeded accounts (local/demo only)
SEED_ADMIN_EMAIL=admin@disruptcyprus.test
SEED_EDITOR_EMAIL=editor@disruptcyprus.test
SEED_READER_EMAIL=reader@disruptcyprus.test
SEED_PASSWORD=password
